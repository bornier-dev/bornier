#
# Access to the debug probes without root, for probe-rs and GDB servers.
# Install in /etc/udev/rules.d/, then: udevadm control --reload && udevadm trigger

# STMicroelectronics ST-LINK/V2, V2-1, V3 (including the V3 on Nucleo boards)
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3748|374a|374b|374d|374e|374f|3752|3753|3754|3757", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# SEGGER J-Link
SUBSYSTEM=="usb", ATTRS{idVendor}=="1366", MODE="0660", GROUP="plugdev", TAG+="uaccess"
