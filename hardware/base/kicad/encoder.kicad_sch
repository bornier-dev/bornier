	)
	(text "Placed four times (encoders 0 to 3).\nPer line: 3.3 k series, Schottky clamp to 0..5 V, bias 4.7 k / 4.7 k at the receiver: an open\nline sits at 2.5 V, so a single-ended encoder (TTL, HTL, open collector) works with its - line\nunconnected. + lines pulled up to the encoder supply. TERM jumpers: shunt on 1-2 for RS-422 only, parked on 2-3 otherwise."
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold no)
			)
			(justify left top)
		)
		(uuid "747547be-d016-5df7-a278-3810bd388645")
	)
