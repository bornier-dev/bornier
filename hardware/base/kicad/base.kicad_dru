(version 1)
# Written by gen/pcb.py: Phoenix UM-BASIC 108 profile, board at level L1. The areas are drawn by pcb.py;
# the mounting holes H* are not parts and may sit in them.
(rule "end elements: no part on the top side at the short edges"
	(condition "A.Type == 'Footprint' && A.Layer == 'F.Cu' && A.intersectsArea('profile end element') && A.Reference != 'H*'")
	(constraint disallow footprint))
(rule "profile walls: no part on the bottom side at the edges"
	(condition "A.Type == 'Footprint' && A.Layer == 'B.Cu' && A.intersectsArea('profile wall')")
	(constraint disallow footprint))
(rule "profile walls: no through-hole lead at the edges, the board rests there"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Hole_Size_X < 3mm && A.intersectsArea('profile wall')")
	(constraint disallow pad))
# JLCPCB multilayer boards: 0.2 mm holes and 0.1 mm spacing at no extra cost. The thermal vias of the ESC
# exposed pad (LAN9253 data sheet land pattern) are 0.2 mm; packages at a 0.65 mm pitch (TPS1H000 HVSSOP,
# TPS62A02 SOT-563) leave 0.15 mm between their own pads.
(rule "thermal vias in exposed pads"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Hole_Size_X < 0.3mm")
	(constraint hole_size (min 0.2mm)))
(rule "pads of one package: R39"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('R39') && B.memberOfFootprint('R39')")
	(constraint clearance (min 0.09mm)))
(rule "pads of one package: R44"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('R44') && B.memberOfFootprint('R44')")
	(constraint clearance (min 0.09mm)))
(rule "pads of one package: U10"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U10') && B.memberOfFootprint('U10')")
	(constraint clearance (min 0.15mm)))
(rule "pads of one package: U21"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U21') && B.memberOfFootprint('U21')")
	(constraint clearance (min 0.15mm)))
(rule "pads of one package: U23"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U23') && B.memberOfFootprint('U23')")
	(constraint clearance (min 0.15mm)))
(rule "pads of one package: U25"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U25') && B.memberOfFootprint('U25')")
	(constraint clearance (min 0.15mm)))
(rule "pads of one package: U27"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U27') && B.memberOfFootprint('U27')")
	(constraint clearance (min 0.15mm)))
(rule "pads of one package: U3"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U3') && B.memberOfFootprint('U3')")
	(constraint clearance (min 0.15mm)))
(rule "pads of one package: U4"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U4') && B.memberOfFootprint('U4')")
	(constraint clearance (min 0.12mm)))
# Functional isolation of the Modbus port (ground loop break): 1 mm between the bus side and the rest.
# KiCad evaluates one order of each pair only: the condition is written both ways.
(rule "Modbus isolation barrier"
	(condition "((A.NetName == '/Modbus/MB_A' || A.NetName == '/Modbus/MB_B' || A.NetName == '/Modbus/VISO' || A.NetName == 'GNDISO' || A.NetName == 'Net-(JP5-A)' || A.NetName == 'Net-(R242-Pad2)' || A.NetName == 'Net-(R244-Pad2)' || A.NetName == 'unconnected-(JP5-B-Pad3)') && !(B.NetName == '/Modbus/MB_A' || B.NetName == '/Modbus/MB_B' || B.NetName == '/Modbus/VISO' || B.NetName == 'GNDISO' || B.NetName == 'Net-(JP5-A)' || B.NetName == 'Net-(R242-Pad2)' || B.NetName == 'Net-(R244-Pad2)' || B.NetName == 'unconnected-(JP5-B-Pad3)') && B.NetName != '' && B.NetName != 'unconnected-*') || ((B.NetName == '/Modbus/MB_A' || B.NetName == '/Modbus/MB_B' || B.NetName == '/Modbus/VISO' || B.NetName == 'GNDISO' || B.NetName == 'Net-(JP5-A)' || B.NetName == 'Net-(R242-Pad2)' || B.NetName == 'Net-(R244-Pad2)' || B.NetName == 'unconnected-(JP5-B-Pad3)') && !(A.NetName == '/Modbus/MB_A' || A.NetName == '/Modbus/MB_B' || A.NetName == '/Modbus/VISO' || A.NetName == 'GNDISO' || A.NetName == 'Net-(JP5-A)' || A.NetName == 'Net-(R242-Pad2)' || A.NetName == 'Net-(R244-Pad2)' || A.NetName == 'unconnected-(JP5-B-Pad3)') && A.NetName != '' && A.NetName != 'unconnected-*')")
	(constraint clearance (min 1mm)))
