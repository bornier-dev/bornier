	)
	(text "A machine has a spindle or a laser: the outputs are shared.\n0-10 V: VFD speed reference. PWM: 5 V push-pull (laser TTL input or PWM spindle).\nEN, DIR: 55 V open drain to 0 V, for a VFD input to its common or a laser gate with its own pull-up;\na TVS clamps the kick of a relay coil driven without a flyback diode.\nEach digital output has a LED that shows its real state."
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold no)
			)
			(justify left top)
		)
		(uuid "1b95af52-bbd0-5aca-ab6b-343e3e68d46e")
	)
