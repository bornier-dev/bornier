		(uuid "6070e118-fee7-52d3-9bd6-6a139774bf9d")
	)
	(text "Isolated half-duplex RS-485: the bus side is powered by the DC-DC inside the transceiver (VISO = 3.3 V).\nBornier is the master of the line, so it biases it: 370 mV at idle with a 120 ohm termination at each end.\nTERM: shunt on 1-2 when Bornier sits at an end of the line. Wiring: D1 (A), D0 (B), common, shield."
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold no)
			)
			(justify left top)
		)
		(uuid "a89dbb27-8e48-5728-bae0-a229c8fde7cf")
	)
